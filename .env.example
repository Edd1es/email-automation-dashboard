# `npm run setup` copies this file to .env and fills in the __PLACEHOLDER__ values.
# Never commit .env.

# Required secrets
FLASK_SECRET_KEY=__FLASK_SECRET_KEY__
INTERNAL_API_TOKEN=__INTERNAL_API_TOKEN__
JWT_SECRET=__JWT_SECRET__

# Dashboard sign-in
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='__ADMIN_PASSWORD_HASH__'

# Groq: leave the key empty to use plain templates and rule-based insight
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google: see "Connect Google" in the README

# Sending
# Must be reachable by recipients for open, click and unsubscribe links to work.
PUBLIC_BASE_URL=http://localhost:4000
# US CAN-SPAM requires a valid postal address in commercial email.
SENDER_POSTAL_ADDRESS=
MAX_SEND_PER_RUN=50

# Gateway
GATEWAY_PORT=4000
BACKEND_URL=http://127.0.0.1:5000
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Set to true when running behind one reverse proxy.
TRUST_PROXY=false
